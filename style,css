:root {
  --bg-body: #f4f6f9;
  --bg-surface: #ffffff;
  --bg-surface-alt: #f8fafc;
  --bg-hover: #f1f5f9;
  --border-color: #e2e8f0;
  --text-main: #0f172a;
  --text-muted: #64748b;
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --primary-soft: rgba(37, 99, 235, 0.1);
  --success: #10b981;
  --success-soft: rgba(16, 185, 129, 0.12);
  --warning: #f59e0b;
  --warning-soft: rgba(245, 158, 11, 0.14);
  --danger: #ef4444;
  --danger-soft: rgba(239, 68, 68, 0.12);
  --radius-sm: 0.6rem;
  --radius-md: 1rem;
  --radius-lg: 1.4rem;
  --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06);
  --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
  --transition: 0.18s ease;
}

[data-theme="dark"] {
  --bg-body: #0b1120;
  --bg-surface: #111827;
  --bg-surface-alt: #1e293b;
  --bg-hover: #1e293b;
  --border-color: #273549;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --primary: #3b82f6;
  --primary-hover: #60a5fa;
  --primary-soft: rgba(59, 130, 246, 0.16);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
  --shadow-md: 0 10px 28px rgba(0, 0, 0, 0.4);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 62.5%;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 1.4rem;
  line-height: 1.5;
  color: var(--text-main);
  background: var(--bg-body);
}

/* --- Buttons & Inputs --- */
.owpd-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.7rem 1.2rem;
  font-size: 1.3rem;
  font-weight: 600;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-main);
  cursor: pointer;
  text-decoration: none;
  transition: background var(--transition), border-color var(--transition), transform var(--transition);
}

.owpd-btn:hover {
  background: var(--bg-hover);
}

.owpd-btn--primary {
  background: var(--primary);
  border-color: var(--primary);
  color: #ffffff;
}

.owpd-btn--primary:hover {
  background: var(--primary-hover);
  border-color: var(--primary-hover);
}

.owpd-btn--success {
  background: var(--success-soft);
  border-color: rgba(16, 185, 129, 0.3);
  color: var(--success);
}

.owpd-btn--danger {
  color: var(--danger);
  border-color: rgba(239, 68, 68, 0.3);
}

.owpd-btn--danger:hover {
  background: var(--danger-soft);
}

.owpd-btn--sm {
  padding: 0.45rem 0.85rem;
  font-size: 1.2rem;
}

.owpd-input,
.owpd-select,
.owpd-textarea {
  width: 100%;
  padding: 0.85rem 1.1rem;
  font-size: 1.35rem;
  font-family: inherit;
  color: var(--text-main);
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  outline: none;
  transition: border-color var(--transition);
}

.owpd-input:focus,
.owpd-select:focus,
.owpd-textarea:focus {
  border-color: var(--primary);
}

/* --- Status Badges --- */
.owpd-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.25rem 0.75rem;
  font-size: 1.15rem;
  font-weight: 600;
  border-radius: 999px;
}

.owpd-badge--online {
  background: var(--success-soft);
  color: var(--success);
}

.owpd-badge--offline,
.owpd-badge--error,
.owpd-badge--auth_error {
  background: var(--danger-soft);
  color: var(--danger);
}

.owpd-badge--updates {
  background: var(--warning-soft);
  color: var(--warning);
}

.owpd-badge--neutral {
  background: var(--bg-surface-alt);
  color: var(--text-muted);
  border: 1px solid var(--border-color);
}

.owpd-dot {
  width: 0.75rem;
  height: 0.75rem;
  border-radius: 50%;
  background: currentColor;
}

/* --- SIDE PANEL LAYOUT --- */
.sp-body {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.sp-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  padding: 1.2rem 1.4rem;
  background: var(--bg-surface);
  border-bottom: 1px solid var(--border-color);
}

.sp-header__brand {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 1.5rem;
  font-weight: 800;
  margin: 0;
}

.sp-header__tag {
  font-size: 1.1rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 0.4rem;
  background: var(--primary-soft);
  color: var(--primary);
}

.sp-header__actions {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.sp-toolbar {
  padding: 1rem 1.4rem;
  background: var(--bg-surface-alt);
  border-bottom: 1px solid var(--border-color);
}

.sp-active-context {
  margin: 1.2rem 1.4rem 0;
  padding: 1.1rem 1.2rem;
  background: var(--primary-soft);
  border: 1px solid rgba(37, 99, 235, 0.25);
  border-radius: var(--radius-md);
}

.sp-active-context__label {
  font-size: 1.1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--primary);
  margin-bottom: 0.4rem;
}

.sp-active-context__title {
  font-weight: 700;
  font-size: 1.4rem;
  margin-bottom: 0.8rem;
}

.sp-active-context__links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.sp-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.2rem 1.4rem 2.4rem;
}

.sp-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.2rem;
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition), transform var(--transition);
}

.sp-card:hover {
  border-color: var(--primary);
}

.sp-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.8rem;
}

.sp-card__name {
  font-size: 1.45rem;
  font-weight: 700;
  margin: 0;
}

.sp-card__url {
  font-size: 1.2rem;
  color: var(--text-muted);
  word-break: break-all;
  margin-top: 0.2rem;
}

.sp-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.9rem;
}

.sp-card__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
  margin-top: 1.1rem;
  padding-top: 0.9rem;
  border-top: 1px solid var(--border-color);
}

.sp-card__quicklinks {
  display: flex;
  gap: 0.5rem;
}

/* --- FULLSCREEN DASHBOARD LAYOUT --- */
.db-layout {
  display: grid;
  grid-template-columns: 26rem 1fr;
  min-height: 100vh;
}

.db-sidebar {
  background: var(--bg-surface);
  border-right: 1px solid var(--border-color);
  padding: 2rem 1.6rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.db-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
}

.db-brand__title {
  font-size: 1.7rem;
  font-weight: 800;
  line-height: 1.2;
}

.db-brand__sub {
  font-size: 1.15rem;
  color: var(--text-muted);
  font-weight: 600;
}

.db-nav {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.db-nav__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.9rem 1.2rem;
  border-radius: var(--radius-sm);
  border: none;
  background: transparent;
  color: var(--text-main);
  font-size: 1.4rem;
  font-weight: 600;
  cursor: pointer;
  text-align: left;
}

.db-nav__item:hover,
.db-nav__item--active {
  background: var(--primary-soft);
  color: var(--primary);
}

.db-main {
  padding: 2.4rem 3.2rem;
  max-width: 140rem;
  width: 100%;
}

.db-topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1.6rem;
  margin-bottom: 2.4rem;
}

.db-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  gap: 1.6rem;
  margin-bottom: 2.4rem;
}

.db-stat-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 1.6rem 2rem;
  box-shadow: var(--shadow-sm);
}

.db-stat-card__label {
  font-size: 1.25rem;
  color: var(--text-muted);
  font-weight: 600;
}

.db-stat-card__value {
  font-size: 2.6rem;
  font-weight: 800;
  margin-top: 0.4rem;
}

.db-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(34rem, 1fr));
  gap: 1.8rem;
}

.db-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 2rem;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1.4rem;
}

.db-card__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
}

.db-card__title {
  margin: 0;
  font-size: 1.7rem;
  font-weight: 700;
}

.db-card__category {
  font-size: 1.15rem;
  color: var(--primary);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.db-card__specs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.db-card__footer {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  padding-top: 1.2rem;
  border-top: 1px solid var(--border-color);
}

/* --- MODAL / DETAIL DRAWER --- */
.owpd-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  z-index: 100;
}

.owpd-modal-backdrop--open {
  display: flex;
}

.owpd-modal {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 72rem;
  max-height: 90vh;
  overflow-y: auto;
  padding: 2.4rem;
  box-shadow: var(--shadow-md);
}

.owpd-modal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 1.4rem;
  margin-bottom: 1.8rem;
  border-bottom: 1px solid var(--border-color);
}

.owpd-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.4rem;
}

.owpd-form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.owpd-form-group--full {
  grid-column: 1 / -1;
}

.owpd-form-group label {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-muted);
}

.owpd-update-list {
  list-style: none;
  padding: 0;
  margin: 0.8rem 0 0;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.owpd-update-list li {
  display: flex;
  justify-content: space-between;
  padding: 0.7rem 1rem;
  background: var(--bg-surface-alt);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  font-size: 1.3rem;
}

.owpd-empty {
  text-align: center;
  padding: 3.2rem 1.6rem;
  color: var(--text-muted);
  background: var(--bg-surface);
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-md);
}
