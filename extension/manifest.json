{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "OWPD",
  "version": "0.5",
  "version_name": "0.5-beta",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "views/sidepanel.html"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
