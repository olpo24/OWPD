<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>OWPD – Olpo's WordPressDock Dashboard</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="db-layout">
    <aside class="db-sidebar">
      <div class="db-brand">
        <div>
          <div class="db-brand__title">OWPD</div>
          <div class="db-brand__sub">Olpo's WordPressDock</div>
        </div>
        <button id="db-theme-toggle" class="owpd-btn owpd-btn--sm" data-i18n-title="toggleTheme">◐</button>
      </div>

      <nav class="db-nav" id="db-category-nav">
        <button class="db-nav__item db-nav__item--active" data-filter="all" data-i18n="navAll">All Installations</button>
        <button class="db-nav__item" data-filter="updates" data-i18n="navUpdates">With Updates</button>
        <button class="db-nav__item" data-filter="offline" data-i18n="navOffline">Offline / Errors</button>
      </nav>

      <div style="margin-top: auto; display: flex; flex-direction: column; gap: 0.8rem;">
        <button id="db-export-btn" class="owpd-btn" data-i18n="exportJson">Export JSON</button>
        <label class="owpd-btn" style="cursor: pointer;">
          <span data-i18n="importJson">Import JSON</span>
          <input type="file" id="db-import-input" accept=".json" hidden>
        </label>
      </div>
    </aside>

    <main class="db-main">
      <div class="db-topbar">
        <div style="flex: 1; max-width: 42rem;">
          <input type="search" id="db-search" class="owpd-input" data-i18n-placeholder="dashboardSearchPlaceholder">
        </div>
        <div style="display: flex; gap: 1rem;">
          <button id="db-check-all" class="owpd-btn" data-i18n="checkAllNow">↻ Check all now</button>
          <button id="db-add-btn" class="owpd-btn owpd-btn--primary" data-i18n="addNewSite">+ New WordPress Site</button>
        </div>
      </div>

      <section class="db-stats" id="db-stats"></section>
      <section class="db-grid" id="db-grid"></section>
    </main>
  </div>

  <!-- MODAL -->
  <div id="db-modal-backdrop" class="owpd-modal-backdrop">
    <div class="owpd-modal">
      <div class="owpd-modal__header">
        <h2 id="modal-title" style="margin: 0; font-size: 2rem;">Installation</h2>
        <button id="modal-close" class="owpd-btn owpd-btn--sm" data-i18n="modalClose">✕ Close</button>
      </div>

      <div id="modal-live-details" style="margin-bottom: 2rem;"></div>

      <form id="site-form" class="owpd-form-grid">
        <input type="hidden" id="field-id">

        <div class="owpd-form-group">
          <label for="field-name" data-i18n="labelName">Project / Site Name *</label>
          <input type="text" id="field-name" class="owpd-input" data-i18n-placeholder="placeholderName" required>
        </div>

        <div class="owpd-form-group">
          <label for="field-category" data-i18n="labelCategory">Category / Tag</label>
          <input type="text" id="field-category" class="owpd-input" data-i18n-placeholder="placeholderCategory">
        </div>

        <div class="owpd-form-group owpd-form-group--full">
          <label for="field-url" data-i18n="labelUrl">WordPress URL *</label>
          <input type="url" id="field-url" class="owpd-input" placeholder="https://example.de" required>
        </div>

        <div class="owpd-form-group">
          <label for="field-username" data-i18n="labelUsername">WP Username (for OWPD Companion)</label>
          <input type="text" id="field-username" class="owpd-input" placeholder="admin">
        </div>

        <div class="owpd-form-group">
          <label for="field-app-password" data-i18n="labelAppPassword">WordPress Application Password</label>
          <input type="password" id="field-app-password" class="owpd-input" placeholder="xxxx xxxx xxxx xxxx xxxx xxxx">
        </div>

        <div class="owpd-form-group owpd-form-group--full">
          <label for="field-notes" data-i18n="labelNotes">Notes</label>
          <textarea id="field-notes" class="owpd-textarea" rows="3" data-i18n-placeholder="placeholderNotes"></textarea>
        </div>

        <div class="owpd-form-group--full" style="display: flex; justify-content: space-between; align-items: center; margin-top: 1rem;">
          <button type="button" id="modal-delete-btn" class="owpd-btn owpd-btn--danger" data-i18n="deleteSite">Delete installation</button>
          <div style="display: flex; gap: 1rem;">
            <button type="button" id="modal-check-btn" class="owpd-btn" data-i18n="testStatusNow">Test status now</button>
            <button type="submit" class="owpd-btn owpd-btn--primary" data-i18n="save">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script src="i18n.js"></script>
  <script src="dashboard.js"></script>
</body>
</html>
